{
  "name": "@upcycling/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript client generated from the backend OpenAPI document (ADR-0004). Do not edit src/schema.d.ts by hand.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript openapi.json --output src/schema.d.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3"
  }
}
