{
  "components": {
    "schemas": {
      "ErrorBody": {
        "properties": {
          "code": {
            "description": "Stable, language-neutral error code; clients localize it.",
            "title": "Code",
            "type": "string"
          },
          "details": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "title": "Details",
            "type": "array"
          },
          "message": {
            "description": "Developer-facing English description; not for display.",
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "description": "Stable, language-neutral error code.",
            "title": "Code",
            "type": "string"
          },
          "field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Dotted path of the offending input, if any.",
            "title": "Field"
          },
          "message": {
            "description": "Developer-facing English description.",
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "field",
          "code",
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "HealthResponse",
        "type": "object"
      },
      "Locale": {
        "description": "Supported UI locales. Values are persisted and exposed via the API.",
        "enum": [
          "uk",
          "en"
        ],
        "title": "Locale",
        "type": "string"
      },
      "LoginRequestAccepted": {
        "properties": {
          "challenge_id": {
            "description": "Use with the one-time code from the email.",
            "format": "uuid",
            "title": "Challenge Id",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          }
        },
        "required": [
          "challenge_id",
          "expires_at"
        ],
        "title": "LoginRequestAccepted",
        "type": "object"
      },
      "LoginRequestCreate": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "title": "LoginRequestCreate",
        "type": "object"
      },
      "MeResponse": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "preferred_locale": {
            "$ref": "#/components/schemas/Locale"
          }
        },
        "required": [
          "id",
          "email",
          "preferred_locale"
        ],
        "title": "MeResponse",
        "type": "object"
      },
      "ReadinessResponse": {
        "properties": {
          "status": {
            "const": "ready",
            "default": "ready",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "ReadinessResponse",
        "type": "object"
      },
      "UpdateMeRequest": {
        "additionalProperties": false,
        "properties": {
          "preferred_locale": {
            "$ref": "#/components/schemas/Locale"
          }
        },
        "required": [
          "preferred_locale"
        ],
        "title": "UpdateMeRequest",
        "type": "object"
      },
      "VerifyCodeRequest": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "pattern": "^\\d{6}$",
            "title": "Code",
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "title": "VerifyCodeRequest",
        "type": "object"
      },
      "VerifyTokenRequest": {
        "additionalProperties": false,
        "properties": {
          "token": {
            "maxLength": 256,
            "minLength": 16,
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "title": "VerifyTokenRequest",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Upcycling API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/login-requests": {
      "post": {
        "description": "Always 202 for well-formed input, whether or not the email is registered.",
        "operationId": "create_login_request",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequestCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginRequestAccepted"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Error (see `error.code`)."
          }
        },
        "summary": "Create Login Request",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/login-requests/verify-token": {
      "post": {
        "operationId": "verify_login_token",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyTokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Error (see `error.code`)."
          }
        },
        "summary": "Verify Login Token",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/login-requests/{challenge_id}/verify-code": {
      "post": {
        "operationId": "verify_login_code",
        "parameters": [
          {
            "in": "path",
            "name": "challenge_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Challenge Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyCodeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Error (see `error.code`)."
          }
        },
        "summary": "Verify Login Code",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "description": "Revoke the current session (idempotent).",
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Error (see `error.code`)."
          }
        },
        "summary": "Logout",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/sessions/revoke-all": {
      "post": {
        "description": "Sign out everywhere, including the current device.",
        "operationId": "revoke_all_sessions",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Error (see `error.code`)."
          }
        },
        "summary": "Revoke All Sessions",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "description": "Liveness: the process is serving requests. Does not touch the database.",
        "operationId": "get_health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Error (see `error.code`)."
          }
        },
        "summary": "Get Health",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "description": "Readiness: the database is reachable and migrations are at the expected head.",
        "operationId": "get_readiness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Error (see `error.code`)."
          }
        },
        "summary": "Get Readiness",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/me": {
      "get": {
        "operationId": "get_me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Error (see `error.code`)."
          }
        },
        "summary": "Get Me",
        "tags": [
          "me"
        ]
      },
      "patch": {
        "operationId": "update_me",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateMeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Error (see `error.code`)."
          }
        },
        "summary": "Update Me",
        "tags": [
          "me"
        ]
      }
    }
  }
}
