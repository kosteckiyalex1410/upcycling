# Local development configuration. Copy to `.env` (git-ignored) and adjust.
# Production values are injected by the deployment environment, never committed.

UPCYCLING_ENVIRONMENT=development
UPCYCLING_DATABASE_URL=postgresql+psycopg://upcycling:upcycling@localhost:55432/upcycling

# Origin the expert opens in the browser. Used for magic links and the Origin (CSRF) check.
UPCYCLING_PUBLIC_ORIGIN=http://localhost:5173

# Development only. Production requires a random value of at least 32 characters.
UPCYCLING_SECRET_KEY=dev-only-insecure-secret-key-change-me-0000

# Browsers on plain-HTTP localhost may drop Secure cookies; production forces true.
UPCYCLING_SESSION_COOKIE_SECURE=false

# Mailpit (docker compose) catches all outgoing mail: http://localhost:8025
UPCYCLING_SMTP_HOST=localhost
UPCYCLING_SMTP_PORT=1025
UPCYCLING_SMTP_STARTTLS=false
UPCYCLING_SMTP_FROM=Upcycling <no-reply@upcycling.local>

UPCYCLING_LOG_LEVEL=INFO
